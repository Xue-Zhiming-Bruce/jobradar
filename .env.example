# Every environment variable this repository reads, documented. This file is not
# configuration: nothing loads it, no dependency exists for it, and the app reads
# the process environment with `os.environ`. Copy it to `.env` -- which is
# gitignored -- put real values there, and start the app the way README.md's
# "Run the whole system" section says, or export the same names in your shell.
#
# One line per variable, in the order README.md's Configuration table lists them,
# each with whether the app, the suite or the MCP server works without it and what
# an empty or unset value does. Every value here is a placeholder: a documented
# default, an empty value, or -- for the lines marked SECRET -- nothing at all.
# A marked secret must never be committed: leave the line empty in this file and
# set the real value in your own `.env`, which `.gitignore` keeps out of git.

# Optional. Empty or unset means the local SQLite file backend/data/jobradar.db,
# which needs no setup; compose.yaml points its container at its own PostgreSQL,
# and a deployment points this at Neon. The accepted schemes are sqlite,
# postgresql and postgresql+psycopg. SECRET - the user and the password inside
# that URL are a credential: keep a real one in `.env`, never in a commit.
DATABASE_URL=

# Optional. Empty or unset means ~/.jobradar/uploads, outside the repository, so
# an uploaded resume is never one `git add` away from this public repo; compose
# sets /data/uploads, a named volume that survives a redeploy.
UPLOADS_DIR=

# Optional. The upload limit in bytes. Empty or unset means 10485760, 10 MiB.
MAX_UPLOAD_BYTES=10485760

# Optional. Where the frontend's build is served from. Empty or unset means
# backend/app/static, beside app/main.py, which is where the image copies the
# build; with no build there, the app is the API alone and `GET /` is 404.
STATIC_DIR=

# SECRET - required for the tick, and there is no default. Empty or unset means
# every POST /internal/tick answers 401, so nobody can start a run. Set the same
# value wherever that endpoint is called from: the X-Tick-Secret header, the MCP
# server's own variable below, or the repository secret tick.yml reads.
TICK_SECRET=

# SECRET - optional. It is the bearer token the hosted MCP endpoint requires: every request must
# carry `Authorization: Bearer <this value>`, read from the environment per request. Empty or
# unset means the endpoint answers 401 to every request -- it is off until an operator sets
# it, so a deployment that does not configure it exposes no MCP surface. Set it only on the
# instance; a real value never belongs in this repository.
MCP_AUTH_TOKEN=

# Optional. A comma-separated list of title terms. Empty or unset means no terms,
# so this rule rejects nothing and the posting reaches the scorer.
PREFILTER_TITLE_TERMS=
# Optional. Seniority terms, matched against the posting's title. Empty or unset
# means this rule rejects nothing.
PREFILTER_SENIORITY_TERMS=
# Optional. Location terms, matched against the posting's location. Empty or
# unset means this rule rejects nothing.
PREFILTER_LOCATION_TERMS=
# Optional. Must-have keywords, matched against the title and the description
# together. Empty or unset means this rule rejects nothing.
PREFILTER_MUST_HAVE_KEYWORDS=
# Optional. When on, the active resume's parsed skills are must-haves too: a
# posting whose title and description lack one is rejected before scoring. Empty
# or unset means off, and `1`, `true`, `yes` and `on` are the spellings that turn
# it on.
PREFILTER_MUST_HAVE_FROM_RESUME=

# SECRET - required to score postings and to read a scanned resume. Empty or
# unset means scoring stops at the first posting and the run's row reads failed
# with this variable named; a scanned upload answers 503 naming it. An upload
# that carries its own text needs no key, and so does the prefilter.
LLM_API_KEY=

# Optional. Empty or unset means gpt-4o-mini.
LLM_MODEL=gpt-4o-mini

# Optional. Empty or unset means https://api.openai.com/v1. Every call posts to
# <base>/chat/completions, so an OpenAI-compatible gateway goes here.
LLM_BASE_URL=

# Optional. Empty or unset means no fallback: only LLM_MODEL is tried, and a call
# the model never answered comes back as a not-scored result, not an exception.
LLM_FALLBACK_MODEL=

# Optional. How many postings one run offers the model, and 0 is legitimate.
# Empty or unset means 50; postings past the cap are stored not scored.
SCORER_MAX_POSTINGS=50

# Optional. How many boards one run may ask, and 0 is legitimate: it asks no board
# at all and the run row says how many active companies it left for a later run.
# Empty or unset means 200. A negative value or a value that is not a whole number
# fails the run naming this variable, before any board is called.
RUN_REQUEST_BUDGET=200

# Optional. How many seconds the walk waits between two board calls, and 0 is
# legitimate: it waits nothing. Empty or unset means 1.0. A negative value or a
# value that is not a number fails the run naming this variable, before any board
# is called.
RUN_REQUEST_INTERVAL_SECONDS=1.0

# Optional. The digest cutoff: a scored match at or above it is emailed. Empty or
# unset means 70.
DIGEST_MIN_SCORE=70

# Optional, and one of the three a send needs. Empty or unset means the digest
# sends nothing, and a run that had a match to send fails naming this variable.
SMTP_HOST=

# Optional. Empty or unset means 587, and only a real send reads it.
SMTP_PORT=587

# Optional. Empty or unset means no login, which is what a local relay without
# authentication needs.
SMTP_USERNAME=

# SECRET - optional, and read only when SMTP_USERNAME is set. Leave it empty
# here; a real one belongs in `.env`, where git never sees it.
SMTP_PASSWORD=

# Optional, and one of the three a send needs. Empty or unset means the digest
# sends nothing, and a run that had a match to send fails naming this variable.
DIGEST_FROM=

# Optional, and one of the three a send needs. Empty or unset means the digest
# sends nothing, and a run that had a match to send fails naming this variable.
DIGEST_TO=

# The suite's own variable, not the app's: app/ never reads it, backend/tests/
# does. Optional. Empty or unset means the engine matrix's PostgreSQL parameters
# SKIP and the same tests run on SQLite alone; a URL that is set but unreachable
# FAILS the suite rather than skipping. README.md's Tests section has the
# throwaway server and the URL to point this at.
TEST_DATABASE_URL=

# The MCP server's own setting, not the backend's: only mcp/jobradar_mcp reads
# it, and README.md's MCP section registers it with the client. Optional. It is
# the base URL of the app the tools drive, e.g. http://127.0.0.1:8123. Empty or
# unset makes every tool fail with a tool error naming this variable, while the
# server still starts and lists its tools.
JOBRADAR_URL=

# The MCP server's own setting, not the backend's: the value its tools send as
# X-Tick-Secret, so it must hold what the app above is configured with. SECRET -
# optional here. Empty or unset makes every tool fail with a tool error naming
# it, and the value never reaches a result, an error message or a log line.
JOBRADAR_TICK_SECRET=
