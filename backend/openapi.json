{
  "openapi": "3.1.0",
  "info": {
    "title": "JobRadar API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness check",
        "description": "Report that the process is up. Reads no configuration and no database.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/resume": {
      "post": {
        "tags": [
          "resume"
        ],
        "summary": "Upload the active resume",
        "description": "Accept one file, extract its text, and store it as the single active resume.",
        "operationId": "upload_resume_resume_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_resume_resume_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeUploaded"
                }
              }
            }
          },
          "413": {
            "description": "The upload is larger than the configured limit"
          },
          "415": {
            "description": "The declared type, or the bytes, are not a readable resume"
          },
          "422": {
            "description": "The upload is corrupt, carries no text, or is not a named file part"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_resume_resume_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "A PDF, a DOCX or a UTF-8 text file"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_resume_resume_post"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health",
        "description": "Body of `GET /healthz`."
      },
      "ResumeUploaded": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "content_type": {
            "type": "string",
            "title": "Content Type"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          }
        },
        "type": "object",
        "required": [
          "id",
          "filename",
          "content_type",
          "is_active"
        ],
        "title": "ResumeUploaded",
        "description": "Body of a successful upload: which resume is now the active one."
      }
    }
  }
}
